# Environment variables for Good Secrets Safaris
#
# Copy this file to .env.local for local development (.env.local is
# gitignored and never committed). Vite only exposes variables prefixed
# with VITE_ to client-side code - never put secrets that must stay
# server-side behind that prefix.

# Public site URL, used for canonical links, sitemap generation, and
# absolute Open Graph image URLs.
VITE_SITE_URL="http://localhost:3000, https://www.goodsecretssafaris.com"

# Base URL of the backend API (see /server). Defaults to
# http://localhost:4000 if unset, which matches the backend's own
# default local dev port.
VITE_API_URL="http://localhost:4000"

# Backend origin used at build time to generate sitemap.xml from live content.
SITEMAP_API_URL=http://localhost:4000
