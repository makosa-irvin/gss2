# Environment variables for Good Secrets Safaris
#
# Copy this file to .env.local for local development (.env.local is
# gitignored and never committed). Vite only exposes variables prefixed
# with VITE_ to client-side code - never put secrets that must stay
# server-side behind that prefix.

# Public site URL, used for canonical links, sitemap generation, and
# absolute Open Graph image URLs. This must be ONE origin, not a list.
# Local development:
VITE_SITE_URL="http://localhost:3000"
# Staging example: set this in Vercel to the stable staging/preview URL.
# VITE_SITE_URL="https://your-staging-project.vercel.app"

# Base URL of the backend API (see /server). Do not append /api here;
# the frontend API client appends /api to individual endpoint paths.
VITE_API_URL="http://localhost:4000"
# Staging example:
# VITE_API_URL="https://your-api.up.railway.app"

# Optional GA4 measurement ID. Analytics only loads after the visitor grants
# analytics consent. Leave blank to keep the first-touch attribution and
# internal analytics event hooks without sending data to Google Analytics.
VITE_GA_MEASUREMENT_ID=""

# Backend origin used at build time to generate sitemap.xml from live content.
SITEMAP_API_URL="http://localhost:4000"
# Staging example:
# SITEMAP_API_URL="https://your-api.up.railway.app"
