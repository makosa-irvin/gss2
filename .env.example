# Environment variables for Good Secrets Safaris
#
# The canonical frontend is now the Next.js app under /next-app.
# The legacy Vite names remain supported as migration fallbacks.

# Canonical public origin used by Next metadata, canonical URLs, Open Graph,
# robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production/staging example:
# NEXT_PUBLIC_SITE_URL="https://your-staging-project.vercel.app"

# Server-only Express API origin used by Next Server Components, ISR and the
# same-origin browser API proxy. Do not append /api.
API_URL="http://localhost:4000"
# Production/staging example:
# API_URL="https://your-api.up.railway.app"

# Optional ISR interval for catalog-backed content. Defaults to 900 seconds.
CATALOG_REVALIDATE_SECONDS="900"

# Legacy Vite variables remain accepted by the Next data layer so the existing
# deployment can transition without an immediate environment-variable rename.
VITE_SITE_URL="http://localhost:3000"
VITE_API_URL="http://localhost:4000"

# Legacy Vite-only optional GA4 setting. The migrated Next frontend currently
# retains consented first-party analytics through the existing Express API.
VITE_GA_MEASUREMENT_ID=""

# Legacy sitemap build setting retained only for the old Vite build scripts.
# Next.js now generates sitemap.xml through app/sitemap.ts.
SITEMAP_API_URL="http://localhost:4000"
