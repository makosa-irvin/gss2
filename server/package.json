{
  "name": "good-secrets-safaris-server",
  "private": true,
  "version": "1.0.0",
  "description": "Backend API for Good Secrets Safaris - Express + Drizzle + PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/test",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/db/seed.ts",
    "reset-admin-password": "tsx src/db/resetAdminPassword.ts",
    "update:content-images": "tsx src/db/updateContentImages.ts",
    "seed:prod": "node dist/db/seed.js",
    "reset-admin-password:prod": "node dist/db/resetAdminPassword.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
