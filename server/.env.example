# Copy to .env for local dev (gitignored, never commit real values).

# --- Database ---
# Local dev (matches docker-compose.yml / the setup in README):
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/goodsecretssafaris"
# Production: use your host's connection string (Neon, Supabase, Railway,
# Render Postgres, RDS, etc). Always use the pooled/serverless-friendly
# connection string if your host offers one.

# --- Auth ---
# Generate a real random 32+ byte secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse this value across environments, and never commit a real one.
JWT_SECRET="replace-with-a-long-random-value-min-32-chars"
# How long an admin login session stays valid.
JWT_EXPIRES_IN="12h"

# --- Email (Resend) ---
# Sign up free at https://resend.com - the free tier is generous enough
# for a small operator's enquiry volume. Leaving this unset does NOT
# block the server from starting, but enquiry notification emails will
# be logged to the console instead of actually sent - see
# src/lib/email.ts. That's a safe fallback for local dev, not something
# to rely on in production.
RESEND_API_KEY=""
# Must be a domain you've verified in Resend, or their onboarding
# sandbox address for testing.
ENQUIRY_FROM_EMAIL="Good Secrets Safaris <enquiries@goodsecretssafaris.com>"
# Where new-enquiry notification emails are sent. Can be a comma
# separated list.
ENQUIRY_NOTIFY_EMAIL="bookings@goodsecretssafaris.com"

# --- CORS ---
# The frontend origin(s) allowed to call this API, comma separated.
# Include your local Vite dev server for local development.
CORS_ORIGINS="http://localhost:3000,https://www.goodsecretssafaris.com"

# --- Server ---
PORT="4000"
NODE_ENV="development"

# --- One-time seed script only (npm run seed) ---
# Used to create the first admin login. Not read by the running server
# itself - only by src/db/seed.ts. Remove/rotate after first use if you
# want; it's not a standing credential the app depends on afterward.
SEED_ADMIN_EMAIL="admin@goodsecretssafaris.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# Safety: production seed is blocked unless this is explicitly true.
ALLOW_DESTRUCTIVE_SEED=false
# Use none only when frontend/API are genuinely cross-site; requires HTTPS.
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SECURE=false
