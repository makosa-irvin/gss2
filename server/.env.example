# Copy to .env for local dev (gitignored, never commit real values).
# For staging/production, configure these in the hosting provider instead
# of committing a .env file. Runtime values are validated on startup by
# server/src/config/env.ts so invalid configuration fails fast.

# --- Database (required) ---
# Local dev:
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/goodsecretssafaris"
# Railway staging: reference the managed PostgreSQL DATABASE_URL supplied
# by Railway rather than hard-coding credentials here.

# --- Auth (required) ---
# Minimum accepted length is 16 characters; use a much longer random secret
# in hosted environments. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value-min-32-chars"
JWT_EXPIRES_IN="12h"

# --- Enquiry email notifications (optional at startup; required in production) ---
# Create a Resend API key and verify goodsecretssafaris.com before using a
# @goodsecretssafaris.com sender in staging/production.
RESEND_API_KEY=""
ENQUIRY_FROM_EMAIL="Good Secrets Safaris <enquiries@goodsecretssafaris.com>"
# Comma-separated recipients are supported. Keep info@ as the shared inbox
# and optionally add the admin/owner address as another recipient.
ENQUIRY_NOTIFY_EMAIL="info@goodsecretssafaris.com,admin@goodsecretssafaris.com"

# --- CORS ---
# Comma-separate multiple allowed frontend origins.
CORS_ORIGINS="http://localhost:3000"
# Staging example (set in Railway after Vercel assigns the frontend URL):
# CORS_ORIGINS="https://your-staging-project.vercel.app"

# --- Server ---
# PORT must be an integer from 1 to 65535.
PORT="4000"
# Allowed values: development | test | production
NODE_ENV="development"
# Railway staging should use NODE_ENV=production.

# --- One-time seed script only ---
# These values are consumed by the seed command, not the long-running API.
SEED_ADMIN_EMAIL="admin@goodsecretssafaris.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Admin"

# Production-mode seeding is deliberately blocked unless explicitly enabled.
# Set true only for the initial staging seed, run seed:prod once, then restore false.
ALLOW_DESTRUCTIVE_SEED=false

# --- Admin session cookie ---
# Allowed same-site values: lax | strict | none
# Local same-origin-ish HTTP development:
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SECURE=false
# Vercel frontend + Railway API staging are cross-site HTTPS. Set on Railway:
# ADMIN_COOKIE_SAME_SITE=none
# ADMIN_COOKIE_SECURE=true
# Production validation rejects SameSite=None together with secure=false.
