{
  "redirects": [
    { "source": "/about-2", "destination": "/about", "permanent": true },
    { "source": "/about-2/", "destination": "/about", "permanent": true },
    { "source": "/contact-2", "destination": "/contact", "permanent": true },
    { "source": "/contact-2/", "destination": "/contact", "permanent": true },
    { "source": "/all-tours-and-safaris", "destination": "/safaris", "permanent": true },
    { "source": "/all-tours-and-safaris/", "destination": "/safaris", "permanent": true },
